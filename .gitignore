# Local Claude Code settings (per machine)
.claude/settings.local.json

# repgen's shared answer cache: ~19 MB and growing, regenerable from Lichess/ChessDB
repertoires/repgen-cache.jsonl
# repgen --maia's model (46 MB), downloaded on first use
repertoires/*.onnx
repertoires/*.onnx.part
# explorerdb's indexes (GBs, rebuilt from Lichess's dumps) and their temporary files
*.xdb
*.xdb.tmp/
# Lichess's monthly dumps, read by explorerdb import
*.pgn.zst
/*.pgn

# Scratch copies of the site fetched while investigating (see CLAUDE.md)
ShowGame.css
study.html

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
node_modules/
__pycache__/
*.pyc
