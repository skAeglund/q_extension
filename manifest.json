{
  "manifest_version": 3,
  "name": "Qchess Transpositions",
  "version": "1.14.1",
  "description": "Marks transposing moves in a Qchess chapter, and adds a Practical column: your expected score against real Lichess replies.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://qchess.net/*",
    "https://explorer.lichess.org/*",
    "https://www.chessdb.cn/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Qchess Transpositions",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://qchess.net/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://qchess.net/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
